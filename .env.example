# Canonical site URL for metadata, sitemap and structured data.
# When unset: Vercel's production URL is used, then https://omaar-x.github.io
NEXT_PUBLIC_SITE_URL=

# Legacy Google Apps Script lead endpoint. Intentionally unused: the contact form was omitted because the deployed
# handler requires an `interest` field and the browser cannot read its no-cors response (see google-apps-script/Code.gs).
NEXT_PUBLIC_CONTACT_ENDPOINT=https://script.google.com/macros/s/AKfycbzh7SrCudXmd7qiZwqpAn-Ftfk-NPAXzYpr3Vzy0wrxYQ7VZBXX0mYpdOVlCaIAEdQ0JA/exec

# "true" builds a static export into out/ (GitHub Pages).
STATIC_EXPORT=
